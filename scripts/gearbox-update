#!/usr/bin/env node
// gearbox-update — downstream protocol sync (fences + ADRs)
//
// Usage: run `gearbox-update [--refresh-drift] [--force-redo] [--allow-branch] [--force] [--no-push]`
//   from a downstream repo's root
//   --refresh-drift  re-copy backfilled ADRs whose "upstream has been revised" (ADR-0024):
//                    for a slug-matched copy carrying a sha256 stamp, when the recorded hash
//                    ≠ the upstream file's current hash, rerun the transform against the
//                    upstream's latest content and overwrite (keeps the downstream number,
//                    stamp gets refreshed). This drops any local edits the downstream made to
//                    the copy — a branch + PR review is the safety net, so it's opt-in.
//   --force-redo     if today's backfill branch already exists, delete and rebuild it
//                    (ADR-0025) — the delete waits until every refusal has passed; push uses
//                    --force-with-lease to overwrite the remote. Manual edits on that branch
//                    are lost — confirm there are none before using this.
//                    Default (no flag): resume on it if unmerged, clean it up if merged (#96).
//   --allow-branch   skip the "auto-switch back to main/master" step (ADR-0025) and run
//                    against the current branch. Base-branch correctness is on you — if the
//                    base is wrong, the output isn't trustworthy.
//   --force          re-apply upstream's fence over a hand-edited one; the diff goes into the
//                    report (ADR-0050)
//   --no-push        commit locally, skip the push
//
// Startup safety checks (ADR-0025): the clean-worktree check exempts this tool's own
// gearbox-update-report.md; auto `git checkout main` when not on main/master (unless
// --allow-branch).
//
// What it does:
//   1. Scans for ADRs Gearbox has that downstream lacks, and copies them into
//      docs/gearbox-adr/ under their upstream number (after the dual-directory split,
//      protocol ADR numbers are 1:1 with upstream — no collisions, no renumbering, ADR-0031)
//   2. Syncs supersede relationships (gearbox 0012 → downstream 0006 status becomes
//      partially superseded)
//   3. Writes `.gearbox-version` = the upstream protocol version (the fence marker's, ADR-0023/
//      0050) — on every run, even when nothing else moved
//   4. git add + commit + push to a new branch docs/gearbox-backfill-{date}
//   5. Rewrites the protocol fences in AGENTS.md / CONTEXT.md when upstream moved (ADR-0050) and
//      writes gearbox-update-report.md (the PR body)
//   6. v1 layout (no fence): migrates AGENTS.md / CONTEXT.md to the v2 layout (ADR-0050,
//      scripts/lib/migrate-v1.js) in one commit on the same branch; a "Where to find things"
//      too big for the 32 KiB budget moves to docs/INDEX.md (appended to an existing one). The
//      report says what moved where and what needs a human
//
// What it doesn't do:
//   - Doesn't touch anything in AGENTS.md / CONTEXT.md outside the fences — except the one-time
//     v1 → v2 migration (6.), which rewrites both on the backfill branch, never on main
//   - Doesn't touch any file in the gearbox repo itself (this is a downstream-side tool)
//   - Doesn't run `gh pr create` automatically (left for the user)
//   - Doesn't auto-merge (L1 requires maintainer agreement)
//
// Protocol compliance: this is a personal tool, not a Gearbox protocol change. A backfill PR
// still goes through the downstream's own L1 flow.
// Compared to gearbox-version: version is read-only and reports status; update writes files
// and opens a branch.
//
// Upstream addressing (ADR-0027): env GEARBOX_DIR > local ~/Github/gearbox > .gearbox-upstream
// remote cache (~/.cache/gearbox/, shallow clone). If the remote can't be reached → hard error
// (a failed pull can't be reported as success).

import { readFileSync, writeFileSync, existsSync, readdirSync, statSync, mkdirSync } from "node:fs";
import { createHash } from "node:crypto";
import { execSync } from "node:child_process";
import { join, dirname } from "node:path";
import { env, argv, exit, cwd, stdout, stderr } from "node:process";
import * as tui from "./lib/tui.js";
import { fenceStatus, replaceFence } from "./lib/fence.js";
import { semverGreater } from "./lib/fence-release.js";
import { CHECK_YML, pinSyncYml } from "./lib/workflows.js";
import { runProtocolChecks } from "./lib/protocol-check.js";
import { loadKnown } from "./lib/v1-known.js";
import { migrateV1, MigrationError } from "./lib/migrate-v1.js";

// ============== Config ==============

// Upstream addressing (ADR-0027): resolved at runtime by resolveUpstream() — a hit on
// env/local default uses local, otherwise falls back to the .gearbox-upstream remote
// shallow-clone cache. These three are overwritten by resolveUpstream() at the start of main().
let GEARBOX_DIR = env.GEARBOX_DIR || `${env.HOME}/Github/gearbox`;
let GEARBOX_ADR_DIR = join(GEARBOX_DIR, "docs/gearbox-adr");
let UPSTREAM_URL = null; // = the .gearbox-upstream URL when remote; null when local
const GEARBOX_GITHUB_BASE =
  "https://github.com/real-stanyan/gearbox/blob/master/docs/gearbox-adr";

// CLI args
let refreshDrift = false;
let forceRedo = false;
let allowBranch = false;
let force = false;
let noPush = false;
for (const a of argv.slice(2)) {
  if (a === "--refresh-drift") refreshDrift = true;
  else if (a === "--force-redo") forceRedo = true;
  else if (a === "--allow-branch") allowBranch = true;
  else if (a === "--force") force = true;
  else if (a === "--no-push") noPush = true;
  else if (a === "--help" || a === "-h") {
    console.log(
      "gearbox-update [--refresh-drift] [--force-redo] [--allow-branch] [--force] [--no-push]",
    );
    exit(0);
  } else {
    console.error(`Unknown argument: ${a} (see --help for usage)`);
    exit(1);
  }
}

// Colors
const C = {
  red: (s) => `\x1b[31m${s}\x1b[0m`,
  green: (s) => `\x1b[32m${s}\x1b[0m`,
  yellow: (s) => `\x1b[33m${s}\x1b[0m`,
  dim: (s) => `\x1b[2m${s}\x1b[0m`,
  bold: (s) => `\x1b[1m${s}\x1b[0m`,
  cyan: (s) => `\x1b[36m${s}\x1b[0m`,
};

// ============== helpers ==============

function die(msg, hint = "") {
  tui.fail(msg, hint);
  exit(1);
}

function pad4(n) {
  return String(n).padStart(4, "0");
}

// sha256, first 12 chars (ADR-0021 stamp contract)
function sha12(s) {
  return createHash("sha256").update(s).digest("hex").slice(0, 12);
}

function run(cmd, opts = {}) {
  return execSync(cmd, { encoding: "utf8", stdio: ["pipe", "pipe", "pipe"], ...opts }).trim();
}

function tryRun(cmd) {
  try {
    return run(cmd);
  } catch {
    return null;
  }
}

// Upstream addressing (ADR-0027): env > local default > .gearbox-upstream remote cache.
// Overwrites the module-level GEARBOX_DIR / GEARBOX_ADR_DIR / UPSTREAM_URL. Called at the
// start of main().
function resolveUpstream() {
  const localDir = env.GEARBOX_DIR || `${env.HOME}/Github/gearbox`;
  if (existsSync(join(localDir, "docs/gearbox-adr"))) {
    GEARBOX_DIR = localDir; // local hit (a maintainer's own fleet) — don't touch the remote
    GEARBOX_ADR_DIR = join(GEARBOX_DIR, "docs/gearbox-adr");
    return;
  }
  const cfgPath = join(cwd(), ".gearbox-upstream");
  if (existsSync(cfgPath)) {
    const url = (readFileSync(cfgPath, "utf8").split("\n")[0] || "").trim();
    if (url) {
      const cacheRoot = join(env.XDG_CACHE_HOME || `${env.HOME}/.cache`, "gearbox");
      const cacheDir = join(cacheRoot, sha12(url));
      try {
        if (existsSync(join(cacheDir, ".git"))) {
          run(`git -C "${cacheDir}" fetch -q --depth 1 origin`);
          run(`git -C "${cacheDir}" reset -q --hard FETCH_HEAD`);
        } else {
          mkdirSync(cacheRoot, { recursive: true });
          run(`git clone -q --depth 1 "${url}" "${cacheDir}"`);
        }
      } catch {
        // update actively pulls — if it can't reach upstream, that's a hard error (ADR-0027)
        die(
          `Can't reach the upstream remote (offline?): ${url}`,
          "gearbox-update needs to fetch upstream — check your network or the .gearbox-upstream URL (ADR-0027)",
        );
      }
      GEARBOX_DIR = cacheDir;
      GEARBOX_ADR_DIR = join(cacheDir, "docs/gearbox-adr");
      UPSTREAM_URL = url;
      return;
    }
  }
  // Neither is set: keep the local default, existsSync(GEARBOX_ADR_DIR) reports the error later
  GEARBOX_DIR = localDir;
  GEARBOX_ADR_DIR = join(localDir, "docs/gearbox-adr");
}

// Run a git command feeding stdin (used for multi-line commit messages)
function runWithStdin(cmd, input) {
  return execSync(cmd, {
    input,
    encoding: "utf8",
    stdio: ["pipe", "pipe", "pipe"],
  }).trim();
}

// Extract ADR metadata from the filename + content
function parseAdrFile(filePath) {
  const fileName = filePath.split("/").pop();
  const match = fileName.match(/^(\d{4})-(.+)\.md$/);
  if (!match) return null;
  const num = parseInt(match[1], 10);
  const slug = match[2];

  let content = "";
  try {
    content = readFileSync(filePath, "utf8");
  } catch {
    return null;
  }

  const lines = content.split("\n");
  const titleLine = lines.find((l) => l.startsWith("# ADR-"));
  const title = titleLine ? titleLine.replace(/^# ADR-\d+:\s*/, "") : slug;

  // header = the first 15 lines (enough to cover Status/Date/Provenance/Supersedes/Revises)
  const headerLines = lines.slice(0, 15);
  const headerText = headerLines.join("\n");

  // Parse header fields
  const statusMatch = headerText.match(/^- Status:\s*(.+)$/m);
  const supersedesMatch = headerText.match(/^- Supersedes:\s*ADR-(\d+)/m);
  const supersededByMatch = headerText.match(
    /partially superseded by ADR-(\d+)/,
  );
  // Canonical provenance regex: matches both the install-written "copied from" stamp and the
  // update-written "backfilled from" stamp (Gearbox Task 3/4 provenance contract).
  const provenanceMatch = headerText.match(
    /Provenance:\s*(?:copied|backfilled) from\s*\[?(?:scaffold|gearbox)\s+ADR-(\d+)/i,
  );
  const revisesMatch = headerText.match(/Revises:\s*ADR-(\d+)/);

  return {
    num,
    slug,
    title,
    filePath,
    fileName,
    content,
    status: statusMatch ? statusMatch[1].trim() : null,
    supersedes: supersedesMatch ? parseInt(supersedesMatch[1], 10) : null,
    supersededBy: supersededByMatch
      ? parseInt(supersededByMatch[1], 10)
      : null,
    provenanceGearboxNum: provenanceMatch
      ? parseInt(provenanceMatch[1], 10)
      : null,
    revises: revisesMatch ? parseInt(revisesMatch[1], 10) : null,
    // Only a *copy stamp* counts (same tight pattern as provenanceMatch above): ADR-0004/0005/0006
    // carry an origin-provenance line and ADR-0031's prose mentions the stamp — the loose
    // /- Provenance:/ check made transformAdrContent skip stamping all four (#119).
    hasProvenanceField: /- Provenance:\s*(?:copied|backfilled) from\s*\[?(?:scaffold|gearbox)\s+ADR-/i.test(headerText),
  };
}

function buildAdrIndex(adrDir) {
  const index = new Map(); // num → adr
  if (!existsSync(adrDir)) return index;
  const files = readdirSync(adrDir).filter((f) => /^\d{4}-.*\.md$/.test(f));
  for (const f of files) {
    const adr = parseAdrFile(join(adrDir, f));
    if (adr) index.set(adr.num, adr);
  }
  return index;
}

// ============== entry validation ==============

function validateContext() {
  const downDir = cwd();
  const downAdrDir = join(downDir, "docs/gearbox-adr");

  if (!existsSync(GEARBOX_ADR_DIR)) {
    die(
      `Gearbox ADR directory not found: ${GEARBOX_ADR_DIR}`,
      "set the GEARBOX_DIR env var, or put the upstream git URL in .gearbox-upstream (ADR-0027 remote addressing)",
    );
  }
  if (!existsSync(downAdrDir)) {
    die(
      "Current directory has no docs/gearbox-adr/",
      "run this from a downstream repo's root (Gearbox-protocol projects all have docs/gearbox-adr/)",
    );
  }

  // git repo check
  const inGitRepo = tryRun("git rev-parse --is-inside-work-tree");
  if (inGitRepo !== "true") {
    die("Current directory is not a git repo", "gearbox-update needs git operations");
  }

  // Clean-worktree check (ADR-0025: exempts this tool's own report file — it's disposable and
  // overwritten every run). Only tracked changes (modified/staged/deleted) block: this tool
  // commits file-by-file (git add <path>, never add -A), so untracked files can't be clobbered
  // or swept into a backfill commit — they're listed as an FYI and the run proceeds (#92).
  const statusLines = run("git status --porcelain")
    .split("\n")
    .filter(Boolean)
    .filter((l) => !/gearbox-update-report\.md$/.test(l));
  const trackedDirty = statusLines.filter((l) => !l.startsWith("??"));
  const untracked = statusLines.filter((l) => l.startsWith("??"));
  if (trackedDirty.length > 0) {
    die(
      "Working tree isn't clean, there are uncommitted changes:",
      "commit or stash first, then run gearbox-update (this keeps the script from clobbering your changes):\n" +
        trackedDirty.join("\n"),
    );
  }
  if (untracked.length > 0) {
    stdout.write(
      C.dim(`  ${untracked.length} untracked file(s) present — ignored, backfill commits add files one by one:\n`) +
        C.dim(untracked.map((l) => `  ${l}`).join("\n") + "\n"),
    );
  }

  // Base branch (ADR-0025): auto-switch when not on main/master, so the backfill branch
  // doesn't fork from the wrong base (inheriting stale copies, producing untrustworthy
  // output). --allow-branch skips this — base-branch correctness is on you.
  let branch = run("git rev-parse --abbrev-ref HEAD");
  if (branch !== "main" && branch !== "master") {
    if (allowBranch) {
      stdout.write(
        C.yellow(`⚠️  --allow-branch: running against ${branch} (not main/master)\n`) +
          C.dim("  base-branch correctness is on you — if the base is wrong, the output isn't trustworthy\n"),
      );
    } else {
      const target = tryRun("git rev-parse --verify --quiet main")
        ? "main"
        : tryRun("git rev-parse --verify --quiet master")
          ? "master"
          : null;
      if (!target) {
        die(
          `Currently on ${branch}, and no main/master to switch to`,
          "the backfill branch must be based on the main branch (ADR-0025). To really base it on the current branch: --allow-branch",
        );
      }
      run(`git checkout ${target}`);
      stdout.write(
        C.yellow(`⚠️  Was on ${branch}, auto-switched to ${target} (ADR-0025)\n`) +
          C.dim("  To really run against the original branch: --allow-branch\n"),
      );
      branch = target;
    }
  }

  // Pre-check: does today's branch name already exist? Auto-resolve instead of erroring (#96):
  // merged into base = stale leftover, its work is already in the base → safe-delete and run
  // fresh; unmerged = an earlier run today → switch back onto it and continue (backfills are
  // idempotent, new commits stack on top, manual edits survive). --force-redo deletes and
  // rebuilds (ADR-0025), but the delete waits in main() until every refusal (a stale upstream,
  // a hand-edited fence) has passed — a refused run never costs the branch.
  const today = new Date().toISOString().slice(0, 10);
  const plannedBranch = `docs/gearbox-backfill-${today}`;
  const branchExists = tryRun(`git rev-parse --verify ${plannedBranch} 2>/dev/null`);
  let resume = false;
  let redo = false;
  if (branchExists) {
    if (forceRedo) {
      if (branch === plannedBranch)
        die(`--force-redo can't rebuild ${plannedBranch} while it's checked out`, "switch to main first (or drop --allow-branch)");
      redo = true;
      stdout.write(
        C.yellow(`⚠️  --force-redo: ${plannedBranch} will be deleted and rebuilt once the checks pass\n`) +
          C.dim("  push will use --force-with-lease to overwrite the remote (if it exists)\n"),
      );
    } else if (branch === plannedBranch) {
      // already sitting on today's branch (e.g. --allow-branch) → just continue on it
      stdout.write(C.dim(`  already on ${plannedBranch}, resuming\n`));
      resume = true;
    } else if (
      tryRun(`git merge-base --is-ancestor ${plannedBranch} HEAD && echo merged`)
    ) {
      run(`git branch -d ${plannedBranch}`);
      stdout.write(
        C.dim(`  cleaned up ${plannedBranch} (already merged into ${branch})\n`),
      );
    } else {
      run(`git checkout ${plannedBranch}`);
      stdout.write(
        C.yellow(`⚠️  Today's branch already exists — resuming on ${plannedBranch}\n`) +
          C.dim("  existing commits (incl. manual edits) are kept, new backfills stack on top; full rebuild: gearbox-update --force-redo\n"),
      );
      resume = true;
    }
  }

  return { downDir, downAdrDir, branch, resume, redo, plannedBranch };
}

// ============== matching algorithm ==============

// For each gearbox ADR, decide whether downstream already has it, and how to backfill it
function matchAdrs(gearboxIndex, downIndex, refreshDrift) {
  const actions = []; // { type: 'skip'|'copy'|'refresh', gearbox, target?, reason? }

  for (const [gearboxNum, gearboxAdr] of gearboxIndex) {
    // 1. slug match (downstream has an ADR with the same slug → already backfilled)
    let slugMatch = null;
    for (const [, downAdr] of downIndex) {
      if (downAdr.slug === gearboxAdr.slug) {
        slugMatch = downAdr;
        break;
      }
    }
    if (slugMatch) {
      // hash drift detection (ADR-0021/0024): the upstream hash recorded in the copy vs
      // upstream's current hash
      const recorded = (slugMatch.content.match(/sha256:([0-9a-f]{12})/) ||
        [])[1];
      const drifted = recorded && recorded !== sha12(gearboxAdr.content);
      if (drifted && refreshDrift) {
        actions.push({
          type: "refresh",
          gearbox: gearboxAdr,
          reason: `drift re-copy: recorded sha256:${recorded} ≠ upstream's current hash, overwriting downstream ADR-${pad4(slugMatch.num)}`,
        });
        continue;
      }
      actions.push({
        type: "skip",
        gearbox: gearboxAdr,
        drifted: Boolean(drifted),
        reason: drifted
          ? `slug already exists (downstream ADR-${pad4(slugMatch.num)}), but upstream has been revised (hash drift) — use --refresh-drift to re-copy`
          : `slug already exists (downstream ADR-${pad4(slugMatch.num)})`,
      });
      continue;
    }

    // 2. provenance match (a downstream ADR header reads "backfilled from gearbox ADR-{num}"
    // → already backfilled)
    let provenanceMatch = null;
    for (const [, downAdr] of downIndex) {
      if (downAdr.provenanceGearboxNum === gearboxNum) {
        provenanceMatch = downAdr;
        break;
      }
    }
    if (provenanceMatch) {
      actions.push({
        type: "skip",
        gearbox: gearboxAdr,
        reason: `downstream ADR-${pad4(provenanceMatch.num)}'s provenance field points to this ADR`,
      });
      continue;
    }

    // 3. missing: copy in under gearbox's original number (no collision — the number stays
    // 1:1 with upstream)
    actions.push({
      type: "copy",
      gearbox: gearboxAdr,
      reason: "missing downstream, copying under the gearbox original number",
    });
  }

  return actions;
}

// ============== copying ==============

// Copy a single ADR + apply the provenance stamp (no renumbering — after the dual-directory
// split, the number is 1:1 with upstream, so ADR-XXXX cross-references never need rewriting)
function transformAdrContent(gearboxAdr) {
  const content0 = gearboxAdr.content;

  // Provenance field (append a machine-generated line if the gearbox ADR doesn't already have one)
  if (gearboxAdr.hasProvenanceField) return content0;

  const gearboxUrl = `${GEARBOX_GITHUB_BASE}/${pad4(gearboxAdr.num)}-${gearboxAdr.slug}.md`;
  // Hash stamp (ADR-0021): the first 12 chars of the upstream file's content sha256 — gearbox-version
  // uses it to detect upstream drift on the copy. The format `sha256:[0-9a-f]{12}` is the
  // contract between the two tools.
  const upstreamHash = sha12(gearboxAdr.content);
  const provenanceLine = `- Provenance: backfilled from [gearbox ADR-${pad4(gearboxAdr.num)}](${gearboxUrl}) (gearbox-update tool sync, upstream sha256:${upstreamHash})`;
  const lines = content0.split("\n");
  let insertAt = 1;
  for (let i = 0; i < Math.min(lines.length, 8); i++) {
    if (/^- Date:/.test(lines[i])) {
      insertAt = i + 1;
      break;
    }
  }
  lines.splice(insertAt, 0, provenanceLine);
  return lines.join("\n");
}

// Supersede link: if this backfill includes gearbox 0012, change downstream 0006's status
// (the number is 1:1 with upstream, so the downstream landing number is always 12; the caller
// only invokes this after confirming this run's toCopy includes 0012)
function applySupersedeLink(downAdrDir) {
  const downstream0006Path = join(downAdrDir, "0006-tiered-change-authority.md");
  if (!existsSync(downstream0006Path)) return null;

  let content = readFileSync(downstream0006Path, "utf8");
  const statusLineMatch = content.match(/^- Status:\s*(.+)$/m);
  if (!statusLineMatch) return null;

  const currentStatus = statusLineMatch[1].trim();
  if (/partially superseded/.test(currentStatus)) {
    return { alreadyApplied: true, newNum: 12 };
  }

  const newStatus = `partially superseded by ADR-0012 (auto-synced by gearbox-update)`;
  content = content.replace(
    /^(- Status:\s*).+$/m,
    `$1${newStatus}`,
  );
  writeFileSync(downstream0006Path, content);
  return { alreadyApplied: false, newNum: 12, file: downstream0006Path };
}

// ============== fences (ADR-0050) ==============

function readOr(base, rel) {
  return existsSync(join(base, rel)) ? readFileSync(join(base, rel), "utf8") : "";
}

// Upstream fences + this repo's fence states. Dies when upstream predates fences or a marker
// is malformed — both need a human, not a guess — and when upstream is OLDER than this repo:
// fenceStatus says "behind" whenever the versions differ, so a stale ~/Github/gearbox checkout
// would otherwise downgrade the fences. --force overrides hand edits, never a downgrade.
function planFences(downDir) {
  const files = [
    { file: "AGENTS.md", name: "protocol", text: readOr(downDir, "AGENTS.md"), upText: readOr(GEARBOX_DIR, "AGENTS.md") },
    { file: "CONTEXT.md", name: "glossary", text: readOr(downDir, "CONTEXT.md"), upText: readOr(GEARBOX_DIR, "CONTEXT.md") },
  ];
  for (const f of files) {
    try {
      f.status = fenceStatus(f.text, f.upText, f.name);
    } catch (e) {
      die(
        `Can't read the gearbox:${f.name} fence: ${e.message}`,
        "an upstream without fences predates Gearbox v2 — refresh the gearbox package/checkout; a malformed local marker must be fixed by hand",
      );
    }
    const { local, upstream } = f.status;
    if (local && semverGreater(local.version, upstream.version)) {
      // Under npx, GEARBOX_DIR is the npm package itself (bin/gearbox.js) — no .git to pull.
      const refresh = UPSTREAM_URL
        ? `the .gearbox-upstream remote (${UPSTREAM_URL}) is behind — point it at a current Gearbox, or run npx -y gearbox-agents@2 update`
        : existsSync(join(GEARBOX_DIR, ".git"))
          ? `refresh the upstream checkout: git -C "${GEARBOX_DIR}" pull — or run npx -y gearbox-agents@2 update`
          : `this gearbox-agents package (${GEARBOX_DIR}) is older than this repo — run npx -y gearbox-agents@2 update again once ${local.version} or later is published`;
      die(
        `Upstream gearbox (${upstream.version}) is older than this repo's protocol (${local.version} in ${f.file}) — refusing to downgrade`,
        `${refresh}\n(--force only re-applies over hand edits; it never downgrades a fence)`,
      );
    }
  }
  return { layout: files[0].status.state === "missing" ? "v1" : "v2", files, protocolVersion: files[0].status.upstream.version };
}

// .gearbox-version, parsed once (ADR-0023/0050). `version`: its first non-empty line, for
// display. `current`: the file is byte-for-byte what update writes, CRLF aside (an autocrlf
// checkout). Anything else is rewritten — e.g. a leading blank line, which the protocol check
// reads as a missing stamp — and since the tree starts clean, a rewrite always changes the blob.
function readStamp(path, protocolVersion) {
  const raw = existsSync(path) ? readFileSync(path, "utf8") : null;
  return {
    version: (raw || "").split("\n").map((l) => l.trim()).find(Boolean) || null,
    current: raw !== null && raw.replace(/\r\n/g, "\n") === `${protocolVersion}\n`,
  };
}

// v1 → v2 migration plan (ADR-0050): a v1 AGENTS.md has no protocol fence. Read-only and run
// before the branch step, like planFences, so every refusal leaves the repo as it was. Refused:
// a CONTEXT.md that already has its fence (half-migrated — migrating it again would add a second
// glossary fence); an uncommitted file the migration rewrites (a v1 AGENTS.md / CONTEXT.md must
// stay in git history — the report points there — and an untracked docs/INDEX.md would be swept
// whole into the commit, which untracked files never are, #92); a file whose code fences don't
// pair up (MigrationError, which names the line to fix).
const INDEX_PATH = "docs/INDEX.md";
const INDEX_MOVED_HEADING = "## Moved from AGENTS.md (Gearbox v2 migration)";

function planMigration(downDir, files) {
  const [agentsFile, contextFile] = files;
  if (contextFile.status.state !== "missing")
    die(
      "CONTEXT.md has a gearbox:glossary fence while AGENTS.md has no gearbox:protocol fence",
      "a half-migrated tree — restore the v1 CONTEXT.md (git log -p -- CONTEXT.md) so update migrates both files together, or finish AGENTS.md by hand from a fresh `npx gearbox-agents install` in a scratch dir",
    );
  const uncommitted = (rel) => existsSync(join(downDir, rel)) && tryRun(`git cat-file -e "HEAD:${rel}"`) === null;
  for (const f of files)
    if (uncommitted(f.file))
      die(
        `${f.file} isn't committed — the v1 → v2 migration rewrites it, and its v1 text must stay in git history (ADR-0050)`,
        "commit it first, then rerun gearbox-update — nothing was written",
      );
  let m;
  try {
    m = migrateV1({
      agentsMd: agentsFile.text,
      contextMd: contextFile.text,
      known: loadKnown(),
      protocolBlock: agentsFile.status.upstream.block,
      glossaryBlock: contextFile.status.upstream.block,
    });
  } catch (e) {
    if (!(e instanceof MigrationError)) throw e;
    die(e.message, "the v1 → v2 migration (ADR-0050) stopped before writing or committing anything");
  }
  // A project may already keep a map in docs/INDEX.md: the moved index is appended, never
  // overwrites it.
  let index = null;
  if (m.indexMd) {
    if (uncommitted(INDEX_PATH))
      die(
        `${INDEX_PATH} isn't committed — the v1 → v2 migration appends the moved index to it and commits the file (ADR-0050)`,
        "commit it (or move it aside) first, then rerun gearbox-update — nothing was written",
      );
    const prior = existsSync(join(downDir, INDEX_PATH)) ? readFileSync(join(downDir, INDEX_PATH), "utf8") : null;
    index = {
      path: INDEX_PATH,
      appended: prior !== null,
      text: prior === null ? m.indexMd : `${prior.trimEnd()}\n\n${INDEX_MOVED_HEADING}\n\n${m.indexMd.replace(/^# Index\n\n/, "")}`,
    };
  }
  // The commit holding the v1 text, for the report's `git show <base>:AGENTS.md`.
  return { ...m, index, base: run("git rev-parse --short=12 HEAD") };
}

function migrationPaths(migration) {
  return ["AGENTS.md", "CONTEXT.md", ...(migration.index ? [migration.index.path] : [])];
}

// Lines present on one side only — enough to show what a hand edit changed.
function lineDiff(localContent, upstreamContent, max = 20) {
  const a = localContent.split("\n");
  const b = upstreamContent.split("\n");
  const sa = new Set(a);
  const sb = new Set(b);
  const fmt = (arr, sign) =>
    arr.slice(0, max).map((l) => `${sign} ${l}`).concat(arr.length > max ? [`${sign} … ${arr.length - max} more`] : []);
  return [...fmt(a.filter((l) => l.trim() && !sb.has(l)), "-"), ...fmt(b.filter((l) => l.trim() && !sa.has(l)), "+")].join("\n");
}

// Tool-owned workflow files (ADR-0051): gearbox-check.yml always matches the template;
// gearbox-sync.yml's npx pin moves from @latest to the major version. Compared with CRLF
// normalized: a core.autocrlf / eol=crlf checkout has CRLF on disk but LF in the index, so a
// byte compare plans a rewrite that stages nothing.
function planWorkflowFixes(downDir) {
  const lf = (text) => text.replace(/\r\n/g, "\n");
  const writes = [];
  const checkPath = ".github/workflows/gearbox-check.yml";
  const current = existsSync(join(downDir, checkPath)) ? readFileSync(join(downDir, checkPath), "utf8") : null;
  if (current === null || lf(current) !== CHECK_YML)
    writes.push({ path: checkPath, text: CHECK_YML, why: current === null ? "added" : "refreshed to the template" });
  const syncPath = ".github/workflows/gearbox-sync.yml";
  if (existsSync(join(downDir, syncPath))) {
    const s = readFileSync(join(downDir, syncPath), "utf8");
    const pinned = pinSyncYml(s); // keeps the file's own line endings
    if (lf(pinned) !== lf(s)) writes.push({ path: syncPath, text: pinned, why: "npx pin @latest → @2" });
  }
  return writes;
}

function generateReport({
  downstreamRepo, assignments, refreshes, supersedeResult, branchName, reportDate, baseBranch,
  fenceWrites, migration, workflowWrites, protocolVersion, localStamp, checkResult, pushed, pushCmd,
}) {
  const lines = [
    "# gearbox-update report",
    "",
    `- Date: ${reportDate}`,
    `- Downstream: ${downstreamRepo}`,
    `- Branch: \`${branchName}\``,
    `- Protocol version: ${localStamp || "(no stamp)"} → ${protocolVersion}`,
    "",
  ];
  if (migration) lines.push(...migrationReportLines(migration));
  if (fenceWrites.length > 0) {
    lines.push("## Protocol fences rewritten", "", "| File | Fence | From | To | Note |", "|---|---|---|---|---|");
    for (const w of fenceWrites)
      lines.push(`| ${w.file} | gearbox:${w.name} | ${w.from} | ${w.to} | ${w.state === "hand-edited" ? "⚠️ overwrote a hand edit (--force)" : "upstream moved"} |`);
    lines.push("");
    for (const w of fenceWrites.filter((x) => x.diff))
      lines.push(
        `### Hand edit overwritten in ${w.file}`,
        "",
        "Lines that differed (- local, + upstream). Re-home anything that mattered in `## Local protocol extensions` / `## Project terms`:",
        "",
        "```diff",
        w.diff,
        "```",
        "",
      );
  }
  if (refreshes.length > 0) {
    lines.push("## ADRs re-copied due to drift (--refresh-drift)", "", "⚠️ Local edits to these copies are gone — check the diff:", "", "| gearbox | slug |", "|---|---|");
    for (const a of refreshes) lines.push(`| ADR-${pad4(a.gearbox.num)} | ${a.gearbox.slug} |`);
    lines.push("");
  }
  if (assignments.length > 0) {
    lines.push("## Backfilled ADRs", "", "| gearbox | slug |", "|---|---|");
    for (const a of assignments) lines.push(`| ADR-${pad4(a.gearbox.num)} | ${a.gearbox.slug} |`);
    lines.push("");
  }
  if (supersedeResult)
    lines.push(
      "## Supersede link (gearbox 0012 → downstream 0006)",
      "",
      supersedeResult.alreadyApplied
        ? "- Downstream 0006's status is already partially superseded (idempotent, not re-applied)"
        : `- Downstream \`docs/gearbox-adr/0006-tiered-change-authority.md\`'s status changed to \`partially superseded by ADR-${pad4(supersedeResult.newNum)}\``,
      "",
    );
  if (workflowWrites.length > 0) {
    lines.push("## Workflow files", "");
    for (const w of workflowWrites) lines.push(`- \`${w.path}\` — ${w.why}`);
    lines.push("");
  }
  lines.push("## Protocol check on this branch", "");
  if (checkResult.errors.length === 0) lines.push("✅ `gearbox-agents check` passes.");
  else {
    lines.push(`❌ ${checkResult.errors.length} problem(s) — this PR's gearbox-check job stays red until they're fixed:`, "");
    for (const e of checkResult.errors) lines.push(`- [ ] ${e}`);
  }
  for (const w of checkResult.warnings) lines.push(`- ⚠️ ${w}`);
  lines.push("", "## Next steps", "");
  if (!pushed) lines.push(`- [ ] push the branch: \`${pushCmd}\``);
  lines.push(
    "- [ ] review the diff; run the Gate and `npx gearbox-agents check`",
    `- [ ] open the PR (the scheduled gearbox-sync Action does this itself): \`gh pr create --base ${baseBranch} --head ${branchName} --body-file gearbox-update-report.md\``,
    "- [ ] merging adopts the new protocol version — L1 in this repo: wait for the maintainer's agreement",
    "- [ ] delete this report file after the PR merges",
    "",
  );
  return lines.join("\n");
}

// The v1 → v2 migration's part of the PR body (spec §4): what moved where, and a checklist of
// what needs a human. Every unknown v1 line is in `## Gate`, in `## Local protocol extensions`,
// or named here (a flagged subsection) — this is where "nothing dropped silently" is kept.
function migrationReportLines(m) {
  const r = m.report;
  const oldText = `\`git show ${m.base}:AGENTS.md\``;
  const notes = r.gateNotes ? ` (+${r.gateNotes} project note line(s) below the command)` : "";
  const L = [
    "## ⚠️ v1 → v2 layout migration (ADR-0050)",
    "",
    `This repo's AGENTS.md held the v1 protocol text, merged by hand. It is now a tool-managed fence — as are CONTEXT.md's protocol terms — and project content lives in the sections around it. Every line that wasn't known upstream text is accounted for below — nothing was dropped silently. The pre-migration text: ${oldText}.`,
    "",
    `- Kept in place: the title and intro, \`## Tech stack\`, \`## Hard rules\`${m.index ? "" : ", `## Where to find things`"} (v1 template notes dropped)`,
    r.maintainer ? `- Maintainer: \`${r.maintainer}\`` : "- [ ] Maintainer: **not detected** — fill in `## Maintainer` (the GitHub account whose PR-comment agreement counts for L1)",
    r.gateMoved
      ? `- Gate command: moved to \`## Gate\`${notes}`
      : `- [ ] Gate command: **not found** — fill in \`## Gate\`, byte-identical to \`.github/workflows/ci.yml\`${notes}`,
    `- Division of labor: ${r.divisionOfLabor === "kept" ? "your v1 choice, kept in `## Division of labor`" : "none chosen in v1 — `## Division of labor` states the default (claim-based ownership)"}`,
  ];
  if (m.index)
    L.push(
      `- Where to find things: ${r.indexMoved.bytes} bytes ${m.index.appended ? `appended to the existing \`${m.index.path}\` under \`${INDEX_MOVED_HEADING}\`` : `moved to a new \`${m.index.path}\``} to fit the 32 KiB budget; AGENTS.md keeps four pointer lines and is ${Buffer.byteLength(m.agentsMd)} bytes`,
    );
  if (r.oversize)
    L.push(`- [ ] **AGENTS.md is still ${r.oversize} bytes (> 32768)** — trim Local protocol extensions or project sections (point to ADRs for detail); the protocol check fails until it fits`);
  L.push("");
  if (r.moved.length) {
    L.push("### Subsections moved verbatim into `## Local protocol extensions`", "");
    for (const t of r.moved)
      L.push(`- [ ] ${t} — set its \`Upstream:\` (an upstream issue link, or \`project-specific\`); if it's a project procedure rather than a protocol extension, move it to a project section`);
    L.push("");
  }
  if (r.carried.length) {
    L.push("### Local lines carried into `## Local protocol extensions`", "");
    for (const c of r.carried)
      L.push(`- [ ] From v1: ${c.section} — ${c.lines} line(s). A line edited in place is carried whole: trim what the fence now says anyway, then set \`Upstream:\``);
    L.push("");
  }
  if (r.flagged.length) {
    L.push(
      "### ⚠️ Subsections flagged for manual review (not carried)",
      "",
      `More than half of each one's lines weren't known upstream text (translated or rewritten), so carrying them would duplicate the protocol. Compare them with the pre-migration text (${oldText}) and move any genuine project rule into \`## Local protocol extensions\`:`,
      "",
    );
    for (const f of r.flagged) L.push(`- [ ] ${f.section} — ${f.unknown}/${f.total} unknown lines`);
    L.push("");
  }
  if (r.extraSections.length) {
    L.push("### Other top-level sections kept as they were", "");
    for (const t of r.extraSections) L.push(`- ${t}`);
    L.push("");
  }
  const c = r.context;
  L.push("### CONTEXT.md", "", `- ${c.removedTerms} protocol term row(s) replaced by the glossary fence; ${c.keptRows} project row(s) kept`);
  if (c.editedTerms.length)
    L.push(`- [ ] Protocol terms whose definition had been edited locally (the fence now carries upstream's — re-home anything project-specific under \`## Project terms\`): ${c.editedTerms.map((t) => `\`${t}\``).join(", ")}`);
  for (const t of [...new Set(c.collisions)])
    L.push(`- [ ] \`${t}\` — kept as a project row, but it's also a protocol term (the glossary fence defines it): confirm it's a product term; if the row restates the protocol meaning, delete it`);
  L.push("");
  return L;
}

// ============== git operations ==============

// Stage `paths` and commit them; false (no commit) when staging changed nothing. A planned write
// can already match the index once git normalizes it (a core.autocrlf / eol=crlf checkout keeps
// LF blobs), and `git commit` would then fail halfway through the sequence.
function commitPaths(paths, message) {
  const spec = paths.join(" ");
  run(`git add -- ${spec}`);
  if (tryRun(`git diff --cached --quiet -- ${spec}`) !== null) return false; // exit 0: nothing staged
  runWithStdin("git commit -F -", message);
  return true;
}

// Returns `made`: one display line per commit that landed, in commit order (a commit skipped by
// commitPaths lands in `unchanged` instead), so the printed list never claims a commit that isn't there.
function gitOps({ assignments, refreshes, supersedeResult, protocolVersion, fenceWrites, migration, workflowWrites, stampCurrent, pushCmd }) {
  const made = [];
  const unchanged = [];
  const commit = (paths, message, label) => {
    const ok = commitPaths(paths, message);
    (ok ? made : unchanged).push(...[].concat(label));
    return ok;
  };

  for (const a of refreshes)
    commit(
      [`docs/gearbox-adr/${pad4(a.gearbox.num)}-${a.gearbox.slug}.md`],
      `docs(adr): drift re-copy ADR-${pad4(a.gearbox.num)} (${a.gearbox.slug})

Upstream gearbox ADR-${pad4(a.gearbox.num)} has been revised (hash drift); rerunning the
transform against upstream's latest content and overwriting, provenance stamp refreshed →
sha256:${sha12(a.gearbox.content)}.
by gearbox-update --refresh-drift (gearbox ADR-0024).
Provenance: ${GEARBOX_GITHUB_BASE}/${pad4(a.gearbox.num)}-${a.gearbox.slug}.md`,
      `drift re-copy ADR-${pad4(a.gearbox.num)} (${a.gearbox.slug})`,
    );

  for (const action of assignments) {
    const g = action.gearbox;
    commit(
      [`docs/gearbox-adr/${pad4(g.num)}-${g.slug}.md`],
      `docs(adr): backfill gearbox ADR-${pad4(g.num)} (${g.slug})

by gearbox-update tool.
Provenance: ${GEARBOX_GITHUB_BASE}/${pad4(g.num)}-${g.slug}.md`,
      `ADR-${pad4(g.num)}`,
    );
  }

  if (supersedeResult && !supersedeResult.alreadyApplied)
    commit(
      ["docs/gearbox-adr/0006-tiered-change-authority.md"],
      `docs(adr): sync 0006 status → partially superseded by ADR-${pad4(supersedeResult.newNum)}

gearbox 0012 supersedes 0006; this commit syncs downstream 0006's status line to
partially superseded. by gearbox-update tool.`,
      "0006 status sync",
    );

  if (migration) commitMigration(commit, migration, protocolVersion);

  if (fenceWrites.length > 0)
    commit(
      fenceWrites.map((w) => w.file),
      `docs(protocol): sync the gearbox fences → ${protocolVersion}

${fenceWrites.map((w) => `- ${w.file} gearbox:${w.name} ${w.from} → ${w.to}${w.state === "hand-edited" ? " (overwrote a hand edit, --force)" : ""}`).join("\n")}

The fenced protocol is rewritten by tooling, never merged by hand (gearbox ADR-0050).
by gearbox-update tool.`,
      fenceWrites.map((w) => `${w.file} gearbox:${w.name} ${w.from} → ${w.to}`),
    );

  if (workflowWrites.length > 0)
    commit(
      workflowWrites.map((w) => w.path),
      `ci: gearbox workflow files (${workflowWrites.map((w) => `${w.path.split("/").pop()} ${w.why}`).join(", ")})

gearbox-check.yml is tool-owned and runs the protocol check on every PR (gearbox ADR-0051);
gearbox-sync.yml pins the major version instead of @latest.
by gearbox-update tool.`,
      workflowWrites.map((w) => `${w.path.split("/").pop()} ${w.why}`).join(", "),
    );

  // .gearbox-version = the protocol version (ADR-0050), committed even when nothing else
  // changed — the pre-v2 early return skipped this and stranded downstreams at v1.15.0.
  // main() parsed it once (readStamp) and already wrote it.
  if (!stampCurrent)
    commit(
      [".gearbox-version"],
      `chore: .gearbox-version → ${protocolVersion}

The protocol version this repo now runs (gearbox ADR-0023, ADR-0050).
by gearbox-update tool.`,
      `.gearbox-version → ${protocolVersion} ${C.dim("(ADR-0023 stamp)")}`,
    );

  let pushResult = null;
  if (!noPush) pushResult = tryRun(`${pushCmd} 2>&1`);
  return { pushResult, made, unchanged };
}

// The v1 → v2 layout change as one commit (ADR-0050), through gitOps' `commit` (commitPaths).
function commitMigration(commit, migration, protocolVersion) {
  const r = migration.report;
  const carried = r.carried.reduce((n, c) => n + c.lines, 0);
  const body = [
    "The protocol body now sits in a tool-managed fence and project content in project",
    `sections (gearbox ADR-0050). Local protocol extensions: ${carried} carried line(s), ${r.moved.length} moved`,
    `subsection(s); ${r.flagged.length} subsection(s) flagged for manual review.`,
    ...(migration.index ? [`"Where to find things" moved to ${migration.index.path} (the 32 KiB AGENTS.md budget).`] : []),
    "The PR body (gearbox-update-report.md) lists what moved where and what needs a",
    "human; the v1 text is this commit's parent.",
    "by gearbox-update tool.",
  ];
  commit(
    migrationPaths(migration),
    `docs(protocol): migrate to the Gearbox v2 layout (${protocolVersion})\n\n${body.join("\n")}`,
    `${migrationPaths(migration).join(" / ")} → the Gearbox v2 layout ${C.dim("(ADR-0050)")}`,
  );
}

// ============== main flow ==============

async function main() {
  await tui.logo();
  if (!tui.isTTY) stdout.write(C.bold(C.cyan("\n⟳ gearbox-update\n")));
  stdout.write(C.dim("  downstream protocol sync (fences + ADRs)\n\n"));

  resolveUpstream(); // upstream addressing (local/remote), overwrites GEARBOX_DIR (ADR-0027)
  const { downDir, downAdrDir, branch, resume, redo, plannedBranch } = validateContext();
  // PR base uses the detected main branch; if running on some other branch, falls back to master
  const baseBranch = branch === "main" || branch === "master" ? branch : "master";

  // repo name
  const remoteUrl = tryRun("git remote get-url origin") || "";
  const downRepo =
    remoteUrl.replace(/.*[:/]/, "").replace(/\.git$/, "") ||
    downDir.split("/").pop();

  stdout.write(`${C.dim("downstream:")}  ${downRepo}\n`);
  stdout.write(
    UPSTREAM_URL
      ? `${C.dim("gearbox:")}     ${UPSTREAM_URL} ${C.dim(`(remote cache ${GEARBOX_DIR}, ADR-0027)`)}\n\n`
      : `${C.dim("gearbox:")}     ${GEARBOX_DIR}\n\n`,
  );

  // scan both sides
  const gearboxIndex = buildAdrIndex(GEARBOX_ADR_DIR);
  const downIndex = buildAdrIndex(downAdrDir);

  if (gearboxIndex.size === 0) {
    die("gearbox ADR directory is empty", `check ${GEARBOX_ADR_DIR}`);
  }

  // Non-TTY keeps the count lines; on a TTY they fold into the scan bar's done-note
  // (output budget, ADR-0041: the logo should still be on screen when the command ends).
  if (!tui.isTTY) {
    stdout.write(
      `${C.dim("gearbox ADRs:")}    ${pad4(Math.max(...gearboxIndex.keys()))} (${gearboxIndex.size} total)\n`,
    );
    stdout.write(
      `${C.dim("downstream ADRs:")} ${pad4(Math.max(...downIndex.keys()))} (${downIndex.size} total)\n\n`,
    );
  }

  // match
  const actions = matchAdrs(gearboxIndex, downIndex, refreshDrift);

  // print diagnostics (sorted ascending by gearbox num, to keep output/commit order stable)
  const skipped = actions.filter((a) => a.type === "skip");
  const toCopy = actions
    .filter((a) => a.type === "copy")
    .sort((a, b) => a.gearbox.num - b.gearbox.num);
  const toRefresh = actions.filter((a) => a.type === "refresh");
  const driftedSkips = skipped.filter((a) => a.drifted);

  const fences = planFences(downDir);
  const protocolVersion = fences.protocolVersion;
  const stampPath = join(downDir, ".gearbox-version");
  const { version: localStamp, current: stampCurrent } = readStamp(stampPath, protocolVersion);
  const fenceWrites = [];
  let migration = null;
  if (fences.layout === "v2") {
    const handEdited = fences.files.filter((f) => f.status.state === "hand-edited");
    if (handEdited.length > 0 && !force)
      die(
        `Hand-edited gearbox fence in ${handEdited.map((f) => f.file).join(" and ")} (ADR-0050)`,
        'move the local rules into "## Local protocol extensions" (AGENTS.md) or "## Project terms" (CONTEXT.md), then rerun with --force to re-apply upstream\'s fence.\nWhat differs from upstream:\n' +
          handEdited.map((f) => `${f.file}:\n${lineDiff(f.status.local.content, f.status.upstream.content)}`).join("\n"),
      );
    for (const f of fences.files) {
      if (f.status.state === "missing")
        die(`${f.file} has no gearbox:${f.name} fence while AGENTS.md has one`, "a half-migrated tree — copy the fence from a fresh `npx gearbox-agents install` into a scratch dir");
      if (f.status.state === "synced") continue;
      fenceWrites.push({
        file: f.file,
        name: f.name,
        state: f.status.state,
        from: f.status.local.version,
        to: f.status.upstream.version,
        diff: f.status.state === "hand-edited" ? lineDiff(f.status.local.content, f.status.upstream.content) : null,
        text: replaceFence(f.text, f.name, f.status.upstream.block),
      });
    }
  } else {
    migration = planMigration(downDir, fences.files);
    const r = migration.report;
    stdout.write(
      C.yellow("⚠️  v1 AGENTS.md layout — migrating to the Gearbox v2 layout (ADR-0050)\n") +
        C.dim(
          `  ${r.carried.reduce((n, c) => n + c.lines, 0)} local line(s) carried · ${r.moved.length} subsection(s) moved · ${r.flagged.length} flagged for review${migration.index ? ` · index → ${migration.index.path}` : ""} — details in the report\n`,
        ),
    );
    // Named here too, not only in the report: a flagged subsection isn't carried anywhere.
    if (r.moved.length) stdout.write(C.dim(`  moved into Local protocol extensions: ${r.moved.join(" · ")}\n`));
    if (r.flagged.length)
      stdout.write(C.yellow(`  ⚠️  flagged for manual review (not carried): ${r.flagged.map((f) => `${f.section} (${f.unknown}/${f.total} unknown lines)`).join(" · ")}\n`));
    stdout.write("\n");
  }
  const workflowWrites = planWorkflowFixes(downDir);

  // TTY: the whole scan collapses into one presentational bar (results are already
  // computed); the per-ADR skip wall is gone — only actionable lines follow (ADR-0041)
  if (tui.isTTY) {
    await tui.progress(
      "ADR scan",
      [...gearboxIndex.values()]
        .sort((a, b) => a.num - b.num)
        .map((a) => `${pad4(a.num)}-${a.slug}`),
      () => {},
      {
        perItemMs: 16,
        doneNote: `${gearboxIndex.size} upstream · ${skipped.length} skipped · ${toCopy.length} to backfill · ${toRefresh.length} drift re-copy`,
      },
    );
    stdout.write("\n");
  }

  if (toCopy.length === 0 && toRefresh.length === 0 && fenceWrites.length === 0 && !migration && workflowWrites.length === 0 && stampCurrent) {
    stdout.write(C.green("✅ Nothing to do — fences, ADRs and .gearbox-version all match upstream\n\n"));
    if (resume) {
      stdout.write(
        C.dim(`  resumed ${plannedBranch}: nothing new to commit — if its PR isn't open yet: gh pr create --base ${baseBranch} --head ${plannedBranch}\n`),
      );
    }
    if (redo) stdout.write(C.dim(`  --force-redo: nothing to rebuild — ${plannedBranch} is left as it was\n`));
    // Non-TTY (CI, pipes): full listing, unchanged. TTY: the scan bar already said it.
    if (!tui.isTTY) {
      stdout.write(C.dim("Already skipped (downstream already has these):\n"));
      for (const a of skipped) {
        stdout.write(
          `  ${C.dim("skip")} ADR-${pad4(a.gearbox.num)} ${a.gearbox.slug} — ${a.reason}\n`,
        );
      }
    }
    if (driftedSkips.length > 0) {
      stdout.write(
        C.yellow(
          `\n⚠️  ${driftedSkips.length} copies have been revised upstream (hash drift) — re-copy with gearbox-update --refresh-drift (ADR-0024)\n`,
        ),
      );
    }
    stdout.write("\n");
    return;
  }

  // Branch first, files second — and only now, past every refusal above: a failing
  // `git branch -D` / `checkout -b` leaves the tree untouched, and a failure mid-commit leaves
  // you on the backfill branch, never with half a sync written onto main.
  const branchName = plannedBranch; // one name for resume, --force-redo's delete and the new branch
  try {
    if (redo) run(`git branch -D ${branchName}`);
    if (!resume) run(`git checkout -b ${branchName}`);
  } catch (e) {
    die(
      `Can't ${redo ? "rebuild" : "create"} ${branchName}: ${e.message}`,
      "nothing was written or committed — a branch checked out in another worktree can't be deleted (git worktree list)",
    );
  }
  if (redo) stdout.write(`${C.yellow("✓ deleted")} the old ${branchName} (--force-redo), rebuilding from ${branch}\n`);

  if (toCopy.length > 0) {
    stdout.write(C.yellow(`⚠️  ${toCopy.length} to backfill:\n`));
    for (const a of toCopy) {
      stdout.write(
        `  ${C.green("[original-number copy]")} gearbox ADR-${pad4(a.gearbox.num)} ${a.gearbox.slug} — ${a.reason}\n`,
      );
    }
  }
  if (toRefresh.length > 0) {
    stdout.write(C.yellow(`⚠️  ${toRefresh.length} to re-copy (drift):\n`));
    for (const a of toRefresh) {
      stdout.write(
        `  ${C.yellow("[drift re-copy]")} gearbox ADR-${pad4(a.gearbox.num)} ${a.gearbox.slug} — ${a.reason}\n`,
      );
    }
  }
  // Skip listing: non-TTY only — on a TTY the scan bar's done-note carries the count (ADR-0041)
  if (!tui.isTTY) {
    stdout.write(`\n${C.dim("Already skipped (downstream already has these):")}\n`);
    for (const a of skipped) {
      stdout.write(
        `  ${C.dim("skip")} ADR-${pad4(a.gearbox.num)} ${a.gearbox.slug} — ${a.reason}\n`,
      );
    }
  }
  if (driftedSkips.length > 0 && !refreshDrift) {
    stdout.write(
      C.yellow(
        `  ⚠️  ${driftedSkips.length} of these have drifted — re-copy with gearbox-update --refresh-drift (ADR-0024)\n`,
      ),
    );
  }
  stdout.write("\n");

  // copy (number is 1:1 with upstream, no more assignment/renumbering)
  if (toCopy.length > 0) {
    stdout.write(C.bold("Copying:\n"));
    if (tui.isTTY) {
      await tui.progress(
        "backfill",
        toCopy.map((a) => `${pad4(a.gearbox.num)}-${a.gearbox.slug}.md`),
        (name, i) => {
          const gearboxAdr = toCopy[i].gearbox;
          const dstPath = join(downAdrDir, `${pad4(gearboxAdr.num)}-${gearboxAdr.slug}.md`);
          writeFileSync(dstPath, transformAdrContent(gearboxAdr));
        },
        { perItemMs: 60, doneNote: `(${toCopy.length} ADRs copied under their upstream numbers)` },
      );
    } else {
      for (const action of toCopy) {
        const gearboxAdr = action.gearbox;
        const dstPath = join(downAdrDir, `${pad4(gearboxAdr.num)}-${gearboxAdr.slug}.md`);
        const transformed = transformAdrContent(gearboxAdr);
        writeFileSync(dstPath, transformed);
        stdout.write(
          `  ${C.green("✓")} ${dstPath.replace(downDir + "/", "")}\n`,
        );
      }
    }
    stdout.write("\n");
  }

  // execute drift re-copies (ADR-0024): keep the downstream number (= upstream original
  // number), rerun the transform against upstream's latest content and overwrite
  if (toRefresh.length > 0) {
    stdout.write(C.bold("Drift re-copy (overwrite, stamp refreshed):\n"));
    for (const a of toRefresh) {
      const dstPath = join(
        downAdrDir,
        `${pad4(a.gearbox.num)}-${a.gearbox.slug}.md`,
      );
      const transformed = transformAdrContent(a.gearbox);
      writeFileSync(dstPath, transformed);
      stdout.write(
        `  ${C.green("✓")} ${dstPath.replace(downDir + "/", "")} ${C.dim(`(upstream sha256:${sha12(a.gearbox.content)})`)}\n`,
      );
    }
    stdout.write("\n");
  }

  // supersede link (only triggers when this run actually backfilled gearbox 0012)
  let supersedeResult = null;
  if (toCopy.some((a) => a.gearbox.num === 12)) {
    stdout.write(C.bold("Supersede link (gearbox 0012 → downstream 0006):\n"));
    supersedeResult = applySupersedeLink(downAdrDir);
    if (supersedeResult) {
      if (supersedeResult.alreadyApplied) {
        stdout.write(
          `  ${C.dim("✓ 0006 status is already partially superseded, idempotent, unchanged")}\n`,
        );
      } else {
        stdout.write(
          `  ${C.green("✓")} 0006 status → partially superseded by ADR-${pad4(supersedeResult.newNum)}\n`,
        );
      }
    } else {
      stdout.write(
        `  ${C.dim("Downstream has no 0006-tiered-change-authority.md, skipping")}\n`,
      );
    }
    stdout.write("\n");
  }

  for (const w of fenceWrites) writeFileSync(join(downDir, w.file), w.text);
  if (migration) {
    writeFileSync(join(downDir, "AGENTS.md"), migration.agentsMd);
    writeFileSync(join(downDir, "CONTEXT.md"), migration.contextMd);
    if (migration.index) {
      mkdirSync(dirname(join(downDir, migration.index.path)), { recursive: true });
      writeFileSync(join(downDir, migration.index.path), migration.index.text);
    }
  }
  for (const w of workflowWrites) {
    mkdirSync(dirname(join(downDir, w.path)), { recursive: true });
    writeFileSync(join(downDir, w.path), w.text);
  }
  if (!stampCurrent) writeFileSync(stampPath, protocolVersion + "\n");

  const reportDate = new Date().toISOString().slice(0, 10);
  // --force-redo rebuilt the branch → overwrite the remote (ADR-0025); every push hint uses this too
  const pushCmd = `git push ${forceRedo ? "--force-with-lease " : ""}-u origin ${branchName}`;

  // The report (the PR body) is written before any commit: a failed git operation below must not
  // lose it — it's the only place a flagged (uncarried) v1 subsection is named (spec §4). Its
  // protocol check reads the working tree, which committing doesn't change; once gitOps has run,
  // only the push line can differ, so the same inputs regenerate it.
  const checkResult = runProtocolChecks(downDir);
  const reportPath = join(downDir, "gearbox-update-report.md");
  const writeReport = (pushed) =>
    writeFileSync(
      reportPath,
      generateReport({
        downstreamRepo: downRepo, assignments: toCopy, refreshes: toRefresh, supersedeResult, branchName, reportDate, baseBranch,
        fenceWrites, migration, workflowWrites, protocolVersion, localStamp, checkResult, pushed, pushCmd,
      }),
    );
  writeReport(false);

  // git operations
  stdout.write(C.bold(`git operations (branch ${branchName}):\n`));
  let pushResult = null;
  try {
    const ops = gitOps({ assignments: toCopy, refreshes: toRefresh, supersedeResult, protocolVersion, fenceWrites, migration, workflowWrites, stampCurrent, pushCmd });
    pushResult = ops.pushResult;
    for (const m of ops.made) stdout.write(`  ${C.green("✓ commit")} ${m}\n`);
    for (const u of ops.unchanged) stdout.write(`  ${C.dim(`· ${u} — already matched the index, nothing to commit`)}\n`);
    if (stampCurrent) stdout.write(`  ${C.dim(`✓ .gearbox-version is already ${protocolVersion}, unchanged`)}\n`);
    if (noPush) stdout.write(`  ${C.dim("push skipped (--no-push)")}\n`);
    else if (pushResult) stdout.write(`  ${C.green("✓ push")} origin/${branchName}\n`);
    else stdout.write(`  ${C.yellow("⚠ push failed — local branch already created, push manually:")}\n     ${pushCmd}\n`);
  } catch (e) {
    // Only the paths this run wrote — like the tool itself, never sweep in the user's untracked files.
    const own = [
      ...(toCopy.length > 0 || toRefresh.length > 0 || (supersedeResult && !supersedeResult.alreadyApplied) ? ["docs/gearbox-adr/"] : []),
      ...(migration ? migrationPaths(migration) : []),
      ...fenceWrites.map((w) => w.file),
      ...workflowWrites.map((w) => w.path),
      ...(stampCurrent ? [] : [".gearbox-version"]),
    ];
    die(
      `git operation failed: ${e.message}`,
      [
        `the files are written on ${branchName} but not all committed; gearbox-update-report.md (the PR body) is written. Finish by hand:`,
        "  git status",
        `  git add -- ${own.join(" ")}`,
        "  git commit",
        `  ${pushCmd}`,
        "or start over — --force-redo deletes and rebuilds today's branch, once this run's writes are gone:",
        `  git checkout -f ${branch} && git clean -fd -- ${own.join(" ")}`,
        "  gearbox-update --force-redo",
      ].join("\n"),
    );
  }
  stdout.write("\n");
  if (pushResult) writeReport(true);

  stdout.write(C.green(`✓ report: ${reportPath.replace(downDir + "/", "")}\n`));
  stdout.write(
    C.dim(
      "  (this file isn't committed — delete it by hand after the PR merges)\n\n",
    ),
  );

  stdout.write(tui.isTTY ? "  " + tui.grad("⚙ downstream in sync") + "\n" : C.bold(C.green("✓ done\n")));
  stdout.write("\n");
  stdout.write(C.bold("Next steps:\n"));
  stdout.write(`  1. Review the branch and ${C.cyan("gearbox-update-report.md")} (the PR body)\n`);
  stdout.write(`  2. Run the Gate and ${C.cyan("npx gearbox-agents check")}\n`);
  stdout.write(`  3. Open a PR: ${C.cyan(`gh pr create --base ${baseBranch} --head ${branchName} --body-file gearbox-update-report.md`)}\n`);
  stdout.write("  4. Merging adopts the new protocol version — L1: wait for the maintainer's agreement\n\n");
}

await main();
