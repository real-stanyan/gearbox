#!/usr/bin/env node
// gearbox-install — one command to scaffold a new project with Gearbox
//
// Usage: run `gearbox-install` from the target project's root, or `gearbox-install <target-dir>`
//   --name <project-name>   AGENTS.md title (default: the git remote's repo name, else the target
//                           directory's name — #133)
//   --maintainer <github-username>  fill the <maintainer> placeholder in "## Maintainer" (default: on an
//                           interactive terminal, offer to bind one — gh-detected default + public-API
//                           existence check, Enter skips (ADR-0036); non-TTY keeps the placeholder).
//                           Use a GitHub username — async L1 approval is checked against it (ADR-0034)
//   --gate "<command>"      the Gate command (default: leave a placeholder, generated in sync with CI)
//
// What it does (automates every manual-copy adjustment step from the README, ADR-0022):
//   1. AGENTS.md   v2 skeleton (project sections: Tech stack / Hard rules / Gate / Maintainer /
//                  Local protocol extensions / Division of labor / Where to find things) + the
//                  upstream protocol fence copied verbatim (ADR-0050)
//   2. CLAUDE.md   = the `@AGENTS.md` empty-shell contract
//   3. CONTEXT.md  the upstream glossary fence + an empty "## Project terms" table
//   4. docs/gearbox-adr/   copies every upstream ADR in full, adds a provenance line + hash stamp
//                  to each (ADR-0021 contract)
//   5. ci.yml      generated, command byte-identical to the Gate section (CI == Gate contract)
//   6. .gearbox-version  writes the upstream protocol version (the fence's) at onboarding time
//                  (ADR-0023 stamp, ADR-0050)
//   7. .gearbox-upstream writes the upstream git URL (ADR-0027 remote addressing; lets downstream
//                        gearbox-version/update clone-and-pull when there's no local GEARBOX_DIR)
//   8. gearbox-check.yml  the protocol-check CI job (ADR-0051)
//   9. docs/adr/older-duplicates.md  only when the target's docs/adr/ already uses an ADR number more
//                  than once and has no such list: records those groups, so they warn once (ADR-0052)
//
// What it doesn't do:
//   - Doesn't copy pull_request_template.md (the downstream-backfill vehicle, Gearbox-specific), scripts/, README.md
//   - Doesn't overwrite or delete any hand-written file (ADR-0038/0039/0040): a Gearbox-made
//     AGENTS.md means "use gearbox-update to backfill" (refusal); hand-written AGENTS.md /
//     CLAUDE.md / CONTEXT.md / ci.yml are preserved as backups and the install proceeds,
//     with a merge notice at the top of the generated AGENTS.md (the user's AGENTS.md stays
//     the single entry point — Gearbox content merges into it); an existing backup file is
//     never overwritten (refusal — unfinished adoption)
//   - Doesn't auto-commit (after install, review by hand + make the first commit)
//
// Protocol text is never transformed: the fences are copied byte-for-byte from upstream (ADR-0050).

import {
  readFileSync,
  writeFileSync,
  existsSync,
  readdirSync,
  mkdirSync,
  renameSync,
} from "node:fs";
import { createHash } from "node:crypto";
import { execSync } from "node:child_process";
import { createInterface } from "node:readline/promises";
import { join, resolve, basename } from "node:path";
import { env, argv, exit, cwd, stdin, stdout } from "node:process";
import * as tui from "./lib/tui.js";
import { findFence, FenceError } from "./lib/fence.js";
import { buildAgentsMd, buildContextMd } from "./lib/skeleton.js";
import { ciYml, SYNC_YML, CHECK_YML } from "./lib/workflows.js";
import { duplicateAdrIds, renderOlderDuplicates, OLDER_DUPLICATES_PATH } from "./lib/adr-ids.js";

// ============== Config ==============

const GEARBOX_DIR = env.GEARBOX_DIR || `${env.HOME}/Github/gearbox`;
const GEARBOX_ADR_DIR = join(GEARBOX_DIR, "docs/gearbox-adr");
const GEARBOX_GITHUB_BASE =
  "https://github.com/real-stanyan/gearbox/blob/master/docs/gearbox-adr";

const C = {
  red: (s) => `\x1b[31m${s}\x1b[0m`,
  green: (s) => `\x1b[32m${s}\x1b[0m`,
  yellow: (s) => `\x1b[33m${s}\x1b[0m`,
  dim: (s) => `\x1b[2m${s}\x1b[0m`,
  bold: (s) => `\x1b[1m${s}\x1b[0m`,
  cyan: (s) => `\x1b[36m${s}\x1b[0m`,
};

function die(msg, hint = "") {
  tui.fail(msg, hint);
  exit(1);
}

function pad4(n) {
  return String(n).padStart(4, "0");
}

// ============== Args ==============

const args = argv.slice(2);
let targetDir = null;
let projectName = null;
let maintainer = null;
let gateCmd = null;

for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === "--name") projectName = args[++i];
  else if (a === "--maintainer") maintainer = args[++i];
  else if (a === "--gate") gateCmd = args[++i];
  else if (a === "--help" || a === "-h") {
    console.log(
      'gearbox-install [target-dir] [--name project-name] [--maintainer github-username] [--gate "command"]',
    );
    exit(0);
  } else if (a.startsWith("--")) die(`Unknown argument: ${a}`, "see --help for usage");
  else if (targetDir) die(`Extra positional argument: ${a}`);
  else targetDir = a;
}

targetDir = resolve(targetDir || cwd());

// Project name (#133): the repo's name, not whatever the clone directory is called.
function remoteRepoName(dir) {
  try {
    const url = execSync("git remote get-url origin", { cwd: dir, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
    return url.replace(/\/+$/, "").replace(/.*[/:]/, "").replace(/\.git$/, "") || null;
  } catch {
    return null;
  }
}
projectName = projectName || remoteRepoName(targetDir) || basename(targetDir);

// ============== Preflight ==============

if (!existsSync(GEARBOX_ADR_DIR))
  die(
    `Gearbox not found: ${GEARBOX_DIR}`,
    "set the GEARBOX_DIR env var to change the path, or make sure Gearbox is at ~/Github/gearbox/",
  );
if (!existsSync(targetDir)) die(`Target directory does not exist: ${targetDir}`);
if (existsSync(join(targetDir, "AGENTS.md"))) {
  // Split on provenance (ADR-0038): AGENTS.md is an industry convention, so the
  // existing file may be hand-written rather than Gearbox-made. Fingerprint = the
  // protocol fence marker (v2, ADR-0050), the Working agreement anchor (present in
  // every Gearbox-generated AGENTS.md, guarded by check-gearbox.js upstream) or the
  // tool-written companions next to it.
  // Gearbox-made → refuse (that's an update, not an install). Hand-written → back it
  // up and proceed (ADR-0039, backup plan built below).
  const existing = readFileSync(join(targetDir, "AGENTS.md"), "utf8");
  const gearboxMade =
    existing.includes("<!-- gearbox:protocol") ||
    existing.includes("## Working agreement (multi-agent)") ||
    existsSync(join(targetDir, ".gearbox-version")) ||
    existsSync(join(targetDir, "docs", "gearbox-adr"));
  if (gearboxMade) {
    die(
      `Target already has a Gearbox AGENTS.md: ${targetDir}`,
      "onboarded projects use gearbox-update to backfill ADRs — don't reinstall with this tool",
    );
  }
}

// Backup plan (ADR-0039/0040): every hand-written file the install would overwrite is
// renamed to a backup in the write phase — the tool never clobbers a user asset and
// never deletes anything. A CLAUDE.md that is already the @AGENTS.md shell is
// overwritten without backup (byte-equivalent, nothing to lose). ci.yml's backup keeps
// a .bak extension so GitHub Actions ignores it (any *.yml in workflows/ would run).
// An existing backup file is a preflight refusal: a previous adoption is unfinished,
// and a backup must never be overwritten — that would be the tool's only path to
// destroying the original file.
const backupPlan = [
  { src: "AGENTS.md", bak: "AGENTS-backup.md", merge: "its rules go into the Hard rules / Tech stack sections" },
  { src: "CLAUDE.md", bak: "CLAUDE-backup.md", merge: "its content belongs in AGENTS.md (CLAUDE.md stays the @AGENTS.md shell)" },
  { src: "CONTEXT.md", bak: "CONTEXT-backup.md", merge: "its glossary entries go under `## Project terms` in the new CONTEXT.md, outside the `gearbox:glossary` fence" },
  { src: ".github/workflows/ci.yml", bak: ".github/workflows/ci.yml.bak", merge: "re-add its jobs alongside the gate job in the new ci.yml" },
  { src: ".github/workflows/gearbox-sync.yml", bak: ".github/workflows/gearbox-sync.yml.bak", merge: "re-apply its customizations (cron cadence etc.) onto the regenerated gearbox-sync.yml" },
  { src: ".github/workflows/gearbox-check.yml", bak: ".github/workflows/gearbox-check.yml.bak", merge: "re-apply its customizations onto the regenerated gearbox-check.yml" },
].filter(({ src }) => {
  if (!existsSync(join(targetDir, src))) return false;
  if (src === "CLAUDE.md" && readFileSync(join(targetDir, src), "utf8").trim() === "@AGENTS.md") return false;
  return true;
});
for (const { bak } of backupPlan)
  if (existsSync(join(targetDir, bak)))
    die(
      `Target already has a ${bak}: ${targetDir}`,
      "a previous adoption is unfinished — merge the backup's content back (then delete it)\n  or remove it first; this tool never overwrites a backup (ADR-0039/0040)",
    );

// Upstream fences (ADR-0050): copied verbatim — install never edits protocol text.
let protocolFence;
let glossaryFence;
try {
  protocolFence = findFence(readFileSync(join(GEARBOX_DIR, "AGENTS.md"), "utf8"), "protocol");
  glossaryFence = findFence(readFileSync(join(GEARBOX_DIR, "CONTEXT.md"), "utf8"), "glossary");
} catch (e) {
  if (!(e instanceof FenceError)) throw e;
  die(`Upstream fence is malformed: ${e.message}`, "the upstream checkout/package is broken — refresh it");
}
if (!protocolFence || !glossaryFence)
  die("Upstream AGENTS.md / CONTEXT.md has no gearbox fence", "this installer needs a v2 upstream (ADR-0050) — check GEARBOX_DIR");

// ============== Interactive maintainer binding (TTY only, ADR-0036) ==============
//
// Why bind at install time: async L1 approval is verified against the maintainer's GitHub
// account (ADR-0034) — an unfilled <maintainer> placeholder matches no account, so L1 stays
// silently dead until someone notices. Unlike the Gate placeholder (backstopped by a
// deliberately-red ci.yml), the placeholder here has no hard check, so the install prompt is
// the best moment to catch it. Binding stays optional: Enter skips, same end state as before.
//
// Deliberately NOT an OAuth flow: install-time identity proof has no consumer — the
// enforcement point is the PR-comment author check, which GitHub itself guarantees. All we
// need is a username string; the existence check below only catches typos.

// gh-detected default: the account gh CLI is logged in as (token-backed, so it's almost
// always the operator). Silent null when gh is missing or logged out.
function detectGithubLogin() {
  try {
    return (
      execSync("gh api user --jq .login", {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
        timeout: 4000,
      }).trim() || null
    );
  } catch {
    return null;
  }
}

// Public users endpoint, no auth needed. Only a 404 disproves the name; rate-limits and
// other statuses pass, and network failure returns null → accept with a warning instead of
// blocking install (offline-tolerant, same spirit as ADR-0027). On success, returns the
// account's type + creation year so the confirmation line makes a mistyped-but-existing
// name (e.g. a squatted short string) visually catchable.
async function githubUserExists(name) {
  try {
    const res = await fetch(`https://api.github.com/users/${encodeURIComponent(name)}`, {
      signal: AbortSignal.timeout(4000),
      headers: { "user-agent": "gearbox-install" },
    });
    if (res.status === 404) return false;
    let info = "";
    try {
      const body = await res.json();
      if (body.type)
        info = ` (${body.type}${body.created_at ? `, since ${body.created_at.slice(0, 4)}` : ""})`;
    } catch {
      /* non-JSON (rate limit page etc.) → verified with no detail */
    }
    return { info };
  } catch {
    return null;
  }
}

async function promptMaintainer() {
  const detected = detectGithubLogin();
  console.log("");
  console.log(
    `${C.bold("Bind a maintainer?")} ${C.dim("L1 approvals are verified against this GitHub account (ADR-0034).")}`,
  );
  const hint = detected
    ? `${C.dim("(Enter =")} ${C.cyan(detected)}${C.dim(', "-" = skip)')}`
    : C.dim("(Enter = skip)");
  const rl = createInterface({ input: stdin, output: stdout });
  rl.on("SIGINT", () => {
    // Ctrl-C at the prompt aborts the whole install — nothing has been written yet.
    rl.close();
    stdout.write("\n");
    exit(130);
  });
  try {
    for (;;) {
      let answer;
      try {
        answer = (await rl.question(`  GitHub username ${hint}: `)).trim();
      } catch {
        return null; // Ctrl-D / closed stdin = skip, same as Enter-with-no-default
      }
      if (answer === "-" || (!answer && !detected)) return null;
      const name = answer || detected;
      const exists = await githubUserExists(name);
      if (exists === false) {
        console.log(`  ${C.yellow("⚠")} ${C.bold(name)} not found on GitHub — check the spelling`);
        continue;
      }
      if (exists === null)
        console.log(
          `  ${C.yellow("⚠")} couldn't reach api.github.com — accepting ${C.bold(name)} unverified (offline?)`,
        );
      else
        console.log(
          `  ${C.green("✓")} ${C.bold(name)} exists on GitHub${C.dim(exists.info || "")}`,
        );
      return name;
    }
  } finally {
    rl.close();
  }
}

// Only prompt on a real interactive terminal and only when --maintainer wasn't given.
// Non-TTY (CI, agent shells, pipes) never prompts — behavior there is unchanged.
if (!maintainer && stdin.isTTY && stdout.isTTY) maintainer = await promptMaintainer();

// ============== 1. AGENTS.md (v2 skeleton + protocol fence) ==============

let agents = buildAgentsMd({ title: projectName, gate: gateCmd, maintainer, protocolBlock: protocolFence.block });

// ============== 2. docs/gearbox-adr/ full copy + hash stamp ==============

const adrFiles = readdirSync(GEARBOX_ADR_DIR)
  .filter((f) => /^\d{4}-.+\.md$/.test(f))
  .sort();
if (adrFiles.length === 0) die("Upstream docs/gearbox-adr/ is empty?");

// Prepare transformed ADR contents here; the writes happen in the animated write phase below.
let stamped = 0;
const adrOutputs = [];
for (const f of adrFiles) {
  let content = readFileSync(join(GEARBOX_ADR_DIR, f), "utf8");
  // Provenance line + hash stamp (ADR-0021 contract: first 12 chars of sha256). Skip only files
  // that already carry a *copy stamp* — match the stamp's own wording, not any "- Provenance:"
  // substring: ADR-0004/0005/0006 carry a legitimate origin-provenance line ("originated in the
  // date-cli experiment") and ADR-0031's prose mentions the stamp; the loose check shipped all
  // four downstream unstamped, with no sha256 for drift detection (#119).
  if (!/- Provenance:\s*(?:copied|backfilled) from\s*\[?(?:scaffold|gearbox)\s+ADR-/.test(content.split("\n").slice(0, 15).join("\n"))) {
    const hash = createHash("sha256").update(content).digest("hex").slice(0, 12);
    const num = f.slice(0, 4);
    const provenanceLine = `- Provenance: copied from [gearbox ADR-${num}](${GEARBOX_GITHUB_BASE}/${f}) (gearbox-install init, upstream sha256:${hash})`;
    const lines = content.split("\n");
    let insertAt = 1;
    for (let i = 0; i < Math.min(lines.length, 8); i++) {
      if (/^- Date:/.test(lines[i])) {
        insertAt = i + 1;
        break;
      }
    }
    lines.splice(insertAt, 0, provenanceLine);
    content = lines.join("\n");
    stamped++;
  }
  adrOutputs.push({ name: f, content });
}

// ============== 3. CONTEXT.md (glossary fence + empty project terms) ==============

const context = buildContextMd({ title: projectName, glossaryBlock: glossaryFence.block });

// ============== 4. CLAUDE.md + ci.yml ==============

const claudeMd = "@AGENTS.md\n";

const ciYmlText = ciYml(gateCmd);

// ============== 5. docs/adr/older-duplicates.md (ADR-0052) ==============

// Install is this project's arrival: project ADR numbers it already uses more than once are recorded,
// so the check warns about them once — renumbering would break their references — while any later
// duplicate fails. Only when there are some, and never over a list already there.
const olderDuplicates = duplicateAdrIds(targetDir, "docs/adr");
const recordOlderDuplicates = olderDuplicates.length > 0 && !existsSync(join(targetDir, OLDER_DUPLICATES_PATH));

// ============== Resolve upstream version + URL (pure reads, before the write phase) ==============

// .gearbox-version (ADR-0023, ADR-0050): the protocol version = the upstream fence's version.
const upstreamVersion = protocolFence.version;

// .gearbox-upstream config (ADR-0027): the upstream git URL, so downstream can do remote
// addressing when there's no local GEARBOX_DIR (pulling from an unfamiliar fork). Prefer the
// origin URL of the upstream clone; in the npx scenario (the package isn't a git repo), fall
// back to reading repository.url from package.json; skip if neither is available.
let upstreamUrl = null;
try {
  upstreamUrl = execSync("git remote get-url origin", {
    cwd: GEARBOX_DIR,
    encoding: "utf8",
    stdio: ["pipe", "pipe", "pipe"],
  }).trim() || null;
} catch {
  /* Upstream clone has no origin remote (e.g. an npx package) → try package.json */
}
if (!upstreamUrl) {
  try {
    const pkg = JSON.parse(readFileSync(join(GEARBOX_DIR, "package.json"), "utf8"));
    upstreamUrl = (pkg.repository && pkg.repository.url) || null;
  } catch {
    /* No package.json / no repository → skip, downstream falls back to GEARBOX_DIR */
  }
}

// ============== Write phase (animated report, ADR-0035; non-TTY prints plain lines) ==============

await tui.logo();
if (!tui.isTTY) {
  console.log("");
  console.log(C.bold("⟳ gearbox-install"));
}
console.log(`${C.dim("Project:")}    ${projectName}`);
console.log(`${C.dim("Directory:")}  ${targetDir}`);
console.log(`${C.dim("Upstream:")}   ${GEARBOX_DIR}`);
console.log("");

if (backupPlan.length > 0) {
  for (const { src, bak } of backupPlan)
    await tui.step(bak, `(your hand-written ${src}, preserved — merge it back, ADR-0039/0040)`, {
      minMs: 250,
      work: () => renameSync(join(targetDir, src), join(targetDir, bak)),
    });
  // In-file merge notice (ADR-0039): the terminal Next-steps output is ephemeral, but
  // AGENTS.md is auto-loaded by every agent tool — so the merge task rides at the top of
  // the file itself. The install is defined as complete when the merge is done and this
  // notice (plus every backup) is deleted.
  agents =
    [
      "> ⚠️ **Unfinished adoption — merge required (ADR-0039/0040).** This project's original",
      "> files were preserved as backups when Gearbox was installed over them. Whoever works",
      "> here next (human or agent): merge each one back, delete the backups, then delete",
      "> this notice. The Gearbox install is not complete until this notice is gone.",
      ">",
      ...backupPlan.map(({ bak, merge }) => `> - \`${bak}\` — ${merge}`),
      "",
      "",
    ].join("\n") + agents;
}
await tui.step(
  "AGENTS.md",
  `(maintainer: ${maintainer || "<maintainer> placeholder"}; Gate: ${gateCmd || "placeholder"})`,
  { minMs: 380, work: () => writeFileSync(join(targetDir, "AGENTS.md"), agents) },
);
await tui.step("CLAUDE.md", "(@AGENTS.md empty-shell contract)", {
  minMs: 180,
  work: () => writeFileSync(join(targetDir, "CLAUDE.md"), claudeMd),
});
await tui.step("CONTEXT.md", "(protocol glossary fence + empty project terms)", {
  minMs: 200,
  work: () => writeFileSync(join(targetDir, "CONTEXT.md"), context),
});
mkdirSync(join(targetDir, "docs/gearbox-adr"), { recursive: true });
await tui.progress(
  "docs/gearbox-adr/",
  adrOutputs.map((o) => o.name),
  (name, i) => writeFileSync(join(targetDir, "docs/gearbox-adr", name), adrOutputs[i].content),
  { doneNote: `(${adrFiles.length} upstream protocol ADRs, ${stamped} stamped with a hash, ADR-0021)` },
);
if (recordOlderDuplicates) {
  const n = olderDuplicates.length;
  await tui.step(
    OLDER_DUPLICATES_PATH,
    `(recorded ${n} older duplicate ADR number${n === 1 ? "" : "s"} — ${n === 1 ? "it warns" : "they warn"} once, any new duplicate fails the check, ADR-0052)`,
    { minMs: 200, work: () => writeFileSync(join(targetDir, OLDER_DUPLICATES_PATH), renderOlderDuplicates(olderDuplicates)) },
  );
}
await tui.step(
  "ci.yml",
  gateCmd
    ? "(same command as the Gate section)"
    : "(placeholder command, deliberately red — CI shouldn't be green before Gate is filled in)",
  {
    minMs: 200,
    work: () => {
      mkdirSync(join(targetDir, ".github/workflows"), { recursive: true });
      writeFileSync(join(targetDir, ".github/workflows/ci.yml"), ciYmlText);
    },
  },
);
await tui.step("gearbox-sync.yml", "(weekly protocol auto-update PRs, ADR-0049 — delete the file to opt out)", {
  minMs: 200,
  work: () => {
    mkdirSync(join(targetDir, ".github/workflows"), { recursive: true });
    writeFileSync(join(targetDir, ".github/workflows/gearbox-sync.yml"), SYNC_YML);
  },
});
await tui.step("gearbox-check.yml", "(protocol check on every PR — fences, 32 KiB budget, CI == Gate, ADR-0051)", {
  minMs: 200,
  work: () => {
    mkdirSync(join(targetDir, ".github/workflows"), { recursive: true });
    writeFileSync(join(targetDir, ".github/workflows/gearbox-check.yml"), CHECK_YML);
  },
});
await tui.step(".gearbox-version", `(${upstreamVersion}, ADR-0023 version stamp)`, {
  minMs: 180,
  work: () => writeFileSync(join(targetDir, ".gearbox-version"), upstreamVersion + "\n"),
});
if (upstreamUrl)
  await tui.step(".gearbox-upstream", `(${upstreamUrl}, ADR-0027 remote addressing)`, {
    minMs: 180,
    work: () => writeFileSync(join(targetDir, ".gearbox-upstream"), upstreamUrl + "\n"),
  });

// git init (when there's no .git)
if (!existsSync(join(targetDir, ".git"))) {
  let gitInited = false;
  try {
    execSync("git init -q", { cwd: targetDir });
    gitInited = true;
  } catch {
    /* Don't block install even if git isn't installed */
  }
  if (gitInited) await tui.step("git init", "", { minMs: 150 });
}

// ============== Next steps ==============

console.log("");
console.log(tui.isTTY ? tui.rule("Next steps") : C.bold("Next steps:"));
let step = 1;
if (backupPlan.length > 0)
  await tui.typeLine(
    `  ${step++}. ${C.yellow("Merge your files back")} from ${C.cyan(backupPlan.map(({ bak }) => bak).join(", "))}, then delete the backups and the ⚠️ notice at the top of AGENTS.md ${C.dim("(the notice repeats this task in-file so the next agent can't miss it; install is complete when it's gone, ADR-0039/0040)")}`,
  );
const placeholderHint =
  "(intro / Tech stack / Hard rules / Division of labor / Where to find things" +
  (maintainer ? "" : " / Maintainer") +
  (gateCmd ? ")" : " / Gate command, sync ci.yml)");
await tui.typeLine(`  ${step++}. Fill in placeholders: ${C.cyan("grep -n '<' AGENTS.md")} ${C.dim(placeholderHint)}`);
await tui.typeLine(`  ${step++}. Write your first own decision to ${C.cyan("docs/adr/<issue>-<slug>.md")} ${C.dim("(named after the issue that settles it, ADR-0052; protocol ADRs live in docs/gearbox-adr/, format in 0001-adr-template.md)")}`);
await tui.typeLine(`  ${step++}. First commit + push, then run ${C.cyan("npx gearbox-agents check")}; step 4 of the start-of-shift steps runs ${C.cyan("gearbox-version")} to self-check the protocol version (pull-triggered, ADR-0026)`);
console.log("");
if (tui.isTTY) console.log("  " + tui.grad("⚙ gearbox ready") + "\n");
